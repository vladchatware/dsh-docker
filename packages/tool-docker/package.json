{
  "name": "@vladchatware/tool-docker",
  "description": "Docker bash tool for DeepSeek Harness",
  "version": "0.1.0-rc.5",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": { "types": "./lib/index.d.ts", "default": "./lib/index.js" },
    "./invariant": { "types": "./lib/invariant.d.ts", "default": "./lib/invariant.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib"],
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": { "@vladchatware/dsh-docker": "^0.1.0-rc.5", "@deepseek-ai/dsh-tools": "^0.1.0-rc.8", "@deepseek-ai/dsh-invariants": "^0.1.0-rc.8", "@deepseek-ai/cordis": "^4.0.1" },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.1" },
  "devDependencies": { "@vladchatware/dsh-docker": "^0.1.0-rc.5", "@deepseek-ai/dsh-tools": "^0.1.0-rc.8", "@deepseek-ai/dsh-llm": "^0.1.0-rc.8", "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.8", "@deepseek-ai/dsh-invariants": "^0.1.0-rc.8", "@deepseek-ai/cordis": "^4.0.1" }
}
