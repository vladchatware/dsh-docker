{
  "name": "dsh-docker-workspace",
  "version": "0.1.0-rc.5",
  "private": true,
  "type": "module",
  "description": "Monorepo for the DeepSeek Harness Docker capability: container owner plus filesystem, bash-tool, and subprocess container adapters.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladchatware/dsh-docker.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^3.0.0"
  }
}
